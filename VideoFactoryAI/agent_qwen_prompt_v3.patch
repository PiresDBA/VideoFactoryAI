+def _parse_qwen_answer(raw: str) -> tuple:
+    """Extrai (trecho_pt, query_en) da resposta. Ambos vazios se o formato não bate."""
+    text = str(raw or "").strip()
+    if text.upper().startswith("NONE"):
+        return "NONE", ""
+    pt = en = ""
+    for line in text.splitlines():
+        line = line.strip().strip("\"'`")
+        low = line.lower()
+        if low.startswith("pt:"):
+            pt = line[3:].strip().strip("\"'`").strip()
+        elif low.startswith("en:"):
+            en = line[3:].strip().strip("\"'`").strip()
+    return pt, en
+

+def _qwen_system_prompt(topic: str) -> str:
+    subject = topic.strip() or "the video topic"
+    lines = [
+        f"You write image search queries for a documentary about: {subject}.",
+        "Given one narration sentence, write the search query for the photo that should appear on screen while it is narrated.",
+        "",
+        "RULES:",
+        "- Describe what the viewer SEES: a concrete object, material, tool, place or action named or clearly implied by the sentence.",
+        "- Keep the specific object names from the sentence, translated to English.",
+        "- 2 to 5 English words. Output only the query: lowercase, no punctuation, no quotes, no explanation.",
+        "- Do NOT add people, history, or famous inventors unless the sentence names them.",
+        "- If the sentence is only a call to action (like, subscribe, thanks, sign-off), output exactly: NONE",
+        "",
+        "EXAMPLES:",
+    ]
+    for sentence, query in QWEN_EXAMPLES:
+        lines.append(f"Sentence: {sentence}")
+        lines.append(f"Query: {query}")
+    return "\n".join(lines)
+
+
+def _ollama_chat(system: str, user: str) -> str:
+    import urllib.request
+    body = {
+        "model": QWEN_MODEL,
+        "stream": False,
+        "keep_alive": "30m",
+        "messages": [{"role": "system", "content": system}, {"role": "user", "content": user}],
+        "options": {"temperature": 0, "num_predict": 24},
+    }
+    request = urllib.request.Request(
+        OLLAMA_URL.rstrip("/") + "/api/chat",
+        data=json.dumps(body).encode("utf-8"),
+        headers={"Content-Type": "application/json"},
+        method="POST",
+    )
+    with urllib.request.urlopen(request, timeout=60) as response:
+        data = json.loads(response.read().decode("utf-8"))
+    return str((data.get("message") or {}).get("content", ""))
+
+
+def _validate_qwen_query(raw: str, scene_text: str) -> tuple:
+    """Retorna (query_limpa, motivo_da_rejeicao). query_limpa vazia = rejeitada."""
+    line = next((item.strip() for item in str(raw or "").splitlines() if item.strip()), "")
+    line = line.strip("\"'`").strip()
+    if not line:
+        return "", "resposta vazia"
+    if line.upper() == "NONE":
+        return "", "cena sem assunto visual"
+    if re.search(r"[^\x00-\x7F]", line):
+        return "", "contém acento: não está em inglês"
+    cleaned = re.sub(r"[^A-Za-z\- ]", " ", line).lower()
+    words = cleaned.split()
+    if not 2 <= len(words) <= 5:
+        return "", f"{len(words)} palavras (use de 2 a 5)"
+    pt = [w for w in words if w in QWEN_PT_WORDS]
+    if pt:
+        return "", "palavras em português: " + ", ".join(pt)
+    text_lower = scene_text.lower()
+    if any(h in cleaned for h in QWEN_HISTORY_WORDS) and not any(h in text_lower for h in QWEN_HISTORY_WORDS):
+        return "", "história que o texto da cena não menciona"
+    return " ".join(words), ""
+

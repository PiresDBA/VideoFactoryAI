+def _primeiro_visivel(page, sel: str):
+    """Entre os elementos que casam com o seletor, devolve o primeiro visível (ordem do DOM)."""
+    try:
+        loc = page.locator(sel)
+        n = min(loc.count(), 15)
+    except Exception:
+        return None
+    for i in range(n):
+        item = loc.nth(i)
+        try:
+            if item.is_visible(timeout=300):
+                return item
+        except Exception:
+            pass
+    return None
+

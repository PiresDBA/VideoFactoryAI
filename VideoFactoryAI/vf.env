# Configuração de escrita do VideoFactoryAI.
# Coloque este arquivo na pasta VideoFactoryAI, ao lado do agent.py.
# Formato: CHAVE=valor (uma por linha). Variáveis já definidas no sistema têm prioridade.

# Escrita do roteiro: cadeia (um site cria o prompt, outro escreve, outro avalia)
VF_MODO_ESCRITA=cadeia
VF_CADEIA_ARQUITETO=gemini
VF_CADEIA_REDATOR=chatgpt
VF_CADEIA_CRITICO=gemini
VF_CADEIA_RODADAS=3
VF_CADEIA_NOTA_MIN=80
VF_IMAGE_GENERATION_PROVIDERS=gemini,copilot,dreamina,chagpt,grok,qwen1

# 0 = se a cadeia falhar, o pipeline para (não cai no roteiro procedural)
VF_WEBCHAT_PERMITIR_FALLBACK=0

# Narração XTTS em trechos
VF_XTTS_CHUNK_CHARS=180
VF_XTTS_PAUSA_MS=250
